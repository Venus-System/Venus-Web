# Decide de onde vêm os dados dos serviços.
# Qualquer valor diferente de "false" mantém os dados falsos de src/services/mocks.
# A ausência do arquivo .env também mantém os dados falsos, que é o padrão seguro.
VITE_USAR_MOCK=true

# Endereço da API. Só é lido quando VITE_USAR_MOCK=false.
# Sem barra no fim: os serviços montam os caminhos como `${VITE_API_URL}/api/...`.
# Use http://localhost:8080 quando estiver rodando o backend na sua máquina.
VITE_API_URL=https://venus-crud.onrender.com

# Firebase Authentication. Sem estas variaveis, o login cai no modo falso
# de src/services/autenticacao.ts e o botao do Google fica desabilitado.
# Apenas API_KEY, AUTH_DOMAIN e PROJECT_ID sao obrigatorias para autenticar.
# A apiKey nao e segredo: ela identifica o projeto e vai no pacote publicado.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
